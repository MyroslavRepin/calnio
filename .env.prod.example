# Copy to .env.prod and fill in. docker-compose.yml loads this file — it is the
# production counterpart of .env, which stays dev-only. Same keys as
# .env.example; only the block at the bottom differs, and that difference is the
# whole point: in prod FastAPI serves the built Vue app itself, so there is one
# origin, no CORS, and ordinary same-site cookies.
#
# The file is gitignored: it holds real secrets. It never enters the image
# either (see .dockerignore) — compose injects it at run time.

# iCloud CalDAV. CALDAV_URL is used by every sync; the other two belong to the
# single-user dev path (services/sync.py's reset_all) — the scheduler runs on
# per-user credentials from the caldav_credentials table.
ICLOUD_EMAIL=
APP_SPECIFIC_PASSWORD=
CALDAV_URL=https://caldav.icloud.com

# Notion — internal integration, single-user dev path only. Real users connect
# through the OAuth integration below.
NOTION_TOKEN=
TASKS_DATA_SOURCE=
EVENT_DUE_DATE_FIELD_NAME=Due Date

# Notion OAuth. The redirect URI must be registered byte-for-byte at
# notion.so/my-integrations — point it at the tunnel hostname, not localhost.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://calnio.example.com/auth/oauth/notion/callback

# Database (psycopg3 driver)
DB_URL=postgresql+psycopg://user:pass@host:5432/calnio

# Scheduler. Only one instance may have this on at a time: a second scheduler
# pointed at the same database syncs every user twice and duplicates their
# iCloud events. Turn it off in .env while this container is running.
SYNCING_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true

# Google OAuth. Register the same URL in the Google Cloud console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://calnio.example.com/auth/oauth/google/callback

# Secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=
JWT_SECRET=

# Fernet key encrypting per-user iCloud app-specific passwords and Notion
# access tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up with the database — losing it makes every stored credential
# permanently unreadable and forces all users to reconnect.
CREDENTIALS_ENCRYPTION_KEY=

# --- Auth cookie / CORS: this is what makes the file a prod file ---
# The public origin. FastAPI serves the SPA from it, so it is also where the
# OAuth callbacks redirect. Not :5173 — there is no Vite server in prod.
FRONTEND_URL=https://calnio.example.com
# Same origin means an ordinary same-site cookie. Secure stays true: the tunnel
# terminates TLS, so the browser is on https.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
